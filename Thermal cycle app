        target_high_input, high_min_input, high_max_input,
        dwell_time_input, sample_interval_input,
        show_all_checkbox
    ]
    outputs = [plot_output, table_output, cycle_table_output, cycle_file_output, status_output]

    file_input.upload(fn=analyze_excel, inputs=inputs, outputs=outputs)
    btn_run.click(fn=analyze_excel, inputs=inputs, outputs=outputs)

