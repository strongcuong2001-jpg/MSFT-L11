    with gr.Row():
        file_input = gr.File(label="📁 上傳 Excel 檔案 / Upload Excel File (.xlsx)", file_types=[".xlsx", ".xls"])
    
    gr.Markdown("### ⚙️ 溫度條件與預覽設定 / Temperature & View Settings")
    with gr.Row():
        target_low_input = gr.Number(label="低溫設定目標 / Low Target (°C)", value=-40)
        low_min_input = gr.Number(label="低溫下限值 / Low Min Bound (°C)", value=-47)
        low_max_input = gr.Number(label="低溫上限值 / Low Max Bound (°C)", value=-37)
        
    with gr.Row():
        target_high_input = gr.Number(label="高溫設定目標 / High Target (°C)", value=100)
        high_min_input = gr.Number(label="高溫下限值 / High Min Bound (°C)", value=97)
        high_max_input = gr.Number(label="高溫上限值 / High Max Bound (°C)", value=103)
    
    with gr.Row():
        dwell_time_input = gr.Number(label="持溫時間 / Dwell Time (min)", value=30)
        sample_interval_input = gr.Number(label="採樣間隔 / Sample Interval (min)", value=1.0)
        show_all_checkbox = gr.Checkbox(label="📄 下方數據表顯示全量原始數據 (顯示 23,000+ 或 50,000+ 全部行)", value=False)
    
    btn_run = gr.Button("🚀 開始分析 / Run Analysis", elem_classes=["primary-btn"])
    
    status_output = gr.Textbox(label="⚡ 執行狀態 / Execution Status", interactive=False)
    
    plot_output = gr.Plot(show_label=False)
    
    gr.Markdown("### 🔍 數據預覽資料表 / Temperature Data Table")
    table_output = gr.Dataframe(label="數據明細 / Data Details", interactive=False)

    gr.Markdown("### ⏱️ Thermal Equilibrium 分析報表 (15 Cycles 最差極限值統計)")
    cycle_table_output = gr.Dataframe(label="15 Cycles 時間計算結果", interactive=False)
    cycle_file_output = gr.File(label="💾 下載 Cycle 平衡時間統計 CSV 報表")

    inputs = [
        file_input, 
