def extract_reports(archive: str, slot: int):
    """從 Slot 的 .tar/.tgz 裡只抽出 nvqual_report_*.xlsx (有快取，第二次不用重抽)。"""
    st = os.stat(archive)
    dest = os.path.join(CACHE_ROOT, f"Slot{slot}_{st.st_size}_{int(st.st_mtime)}")
    marker = os.path.join(dest, ".done")
    if not os.path.exists(marker):
        shutil.rmtree(dest, ignore_errors=True)
        os.makedirs(dest, exist_ok=True)
        mode = "r:" if archive.lower().endswith(".tar") else "r:gz"
        with tarfile.open(archive, mode) as t:
            for m in t:
                base = os.path.basename(m.name)
                if m.isfile() and REPORT_RE.match(base):
                    m.name = base
                    try:
                        t.extract(m, dest, filter="data")
                    except TypeError:  # 舊版 Python 沒有 filter 參數
                        t.extract(m, dest)
        open(marker, "w").close()
    return sorted(os.path.join(dest, f) for f in os.listdir(dest) if REPORT_RE.match(f))


def resolve_nvqual_reports(user_path: str, slot: int):
    """
    使用者輸入可能是：Slot 的 .tar/.tgz 檔、已解壓的資料夾 (含 nvqual_report_*.xlsx)、
    或存放 .tar/.tgz 的資料夾。回傳 ([報表路徑...], 附帶訊息 或 None)
    """
    user_path = clean_path(user_path)
    if not user_path:
        return [], "路徑空白"

    if os.path.isfile(user_path):
        low = user_path.lower()
        if low.endswith((".tar", ".tgz", ".tar.gz")):
            return extract_reports(user_path, slot), None
        if REPORT_RE.match(os.path.basename(user_path)):
            return [user_path], None
        return [], f"不是 .tar/.tgz 也不是 nvqual_report 檔：{user_path}"

    if not os.path.isdir(user_path):
        return [], f"找不到這個路徑：{user_path}"

    reports, archives = [], []
    for root, _dirs, files in os.walk(user_path):
        for fn in files:
            full = os.path.join(root, fn)
            if REPORT_RE.match(fn):
                reports.append(full)
            elif ARCHIVE_RE.search(fn):
                archives.append(full)
    if reports:
        return sorted(reports), None
    # 資料夾裡放的是壓縮檔：只取跟這個 Slot 相符的，.tar 優先 (比 .tgz 快)
    mine = [a for a in archives if slot_of(os.path.basename(a)) == slot]
    if not mine:
        return [], f"資料夾內找不到 Slot {slot} 的 .tar/.tgz 或 nvqual_report 檔"
    mine.sort(key=lambda p: (not p.lower().endswith(".tar"), p))
    return extract_reports(mine[0], slot), None


def read_report(path: str):
    """讀一份 NVQual 報表，回傳 ({模板項目名稱: Avg數值}, [提醒訊息])。"""
    vals, notes = {}, []
    wb = openpyxl.load_workbook(path, read_only=True)
    try:
        def table(sheet, prefix):
            if sheet not in wb.sheetnames:
                notes.append(f"{os.path.basename(path)}: 找不到工作表 {sheet}")
                return {}
            hdr, rows = None, {}
            for row in wb[sheet].iter_rows(min_row=1, max_row=40, values_only=True):
                if row[0] == "System Thermal Qualification Test Summary":
                    hdr = list(row)
                elif hdr and row[0] and str(row[0]).startswith(prefix):
                    rows[str(row[0])] = dict(zip(hdr, row))
            return rows

        def avg(row, *words):
            for k, v in row.items():
                if k and k.startswith("Avg.") and all(w in k for w in words):
                    return v
            return None

        gpus = table(GPU_SHEET, "GPU ")
        for i, pcie in GPU_PCIE.items():
            r = gpus.get("GPU " + pcie)
            if r:
                vals[f"GPU{i}_AVG_TMP"] = avg(r, "TJAvg")
                vals[f"GPU{i}_PWR"] = avg(r, "GPU Power")
        cpus = table(CPU_SHEET, "Socket ")
        for s in (0, 1):
            r = cpus.get(f"Socket {s}")
            if r:
                vals[f"M{s}_CPU_PWR0"] = avg(r, "Total CPU Power")
                vals[f"M{s}_CPU_TMPAVG0"] = avg(r, "CPU TJAvg")
    finally:
        wb.close()
    return {k: v for k, v in vals.items() if isinstance(v, (int, float))}, notes


def collect_nvqual(reports):
    """讀取所有 run 的報表，每個項目取最大值。回傳 (values, notes)。"""
    best, notes = {}, []
    for rp in reports:
        try:
            v, n = read_report(rp)
        except Exception as e:
            notes.append(f"{os.path.basename(rp)}: 讀取失敗 - {e}")
            continue
        notes += n
        for k, x in v.items():
            if k not in best or x > best[k]:
                best[k] = x
    if all(f"GPU{i}_PWR" in best for i in range(4)):
        best["GPU_PWR_SUM"] = sum(best[f"GPU{i}_PWR"] for i in range(4))
    return best, notes


# ------------------------------------------------------------------
# 4. 自動比對「上層資料夾」底下的內容 -> Slot 編號
# ------------------------------------------------------------------

def _new_match_result():
    return {"matched": {}, "unmatched_folders": [], "missing_slots": list(SLOT_NUMBERS),
            "ambiguous": [], "error": None}


def auto_match_slot_folders(parent_dir: str):
    """
    掃描 parent_dir 底下「第一層」子資料夾，依名稱裡的 SlotN 自動對應到
    18 個 Slot 編號 (用在 SDR log 上層資料夾)。

    回傳 dict:
      matched            {slot_num: folder_path}
      unmatched_folders  名稱裡沒找到 SlotN、或編號不在 18 個裡的
      missing_slots      18 個裡沒配到資料夾的
      ambiguous          同一個 slot 配到超過一個資料夾 (取第一個，其餘列在這)
      error              None 或錯誤訊息字串
    """
    result = _new_match_result()
    parent_dir = clean_path(parent_dir)
    if not parent_dir or not os.path.isdir(parent_dir):
        result["error"] = f"找不到這個資料夾：{parent_dir}"
        return result
    try:
        entries = [n for n in sorted(os.listdir(parent_dir))
                   if os.path.isdir(os.path.join(parent_dir, n))]
    except OSError as e:
        result["error"] = f"讀取資料夾失敗：{e}"
        return result

    matched = {}
    for name in entries:
        m = SLOT_NAME_RE.search(name)
        if not m or int(m.group(1)) not in SLOT_NUMBERS:
            result["unmatched_folders"].append(name)
            continue
        slot_num = int(m.group(1))
        if slot_num in matched:
            result["ambiguous"].append((slot_num, name))
        else:
            matched[slot_num] = os.path.join(parent_dir, name)
    result["matched"] = matched
    result["missing_slots"] = [s for s in SLOT_NUMBERS if s not in matched]
    return result


def auto_match_nvqual(parent_dir: str):
    """
    掃描 parent_dir (含所有子層)，找出每個 Slot 的 NVQual 資料：
    優先用 SlotN.tar / SlotN.tgz 壓縮檔 (.tar 優先)，沒有壓縮檔就用已解壓的 SlotN 資料夾。
    回傳格式與 auto_match_slot_folders 相同。
    """
    result = _new_match_result()
    parent_dir = clean_path(parent_dir)
    if not parent_dir or not os.path.isdir(parent_dir):
        result["error"] = f"找不到這個資料夾：{parent_dir}"
        return result

    archives, folders = {}, {}
    parent_abs = os.path.abspath(parent_dir)
    for root, _dirs, files in os.walk(parent_abs):
        for fn in files:
            full = os.path.join(root, fn)
            m = ARCHIVE_RE.search(fn)
            if m:
                s = int(m.group(1))
                if s not in SLOT_NUMBERS:
                    continue
                if s in archives:
                    # .tar 比 .tgz 快，取 .tar；其餘重複的列入 ambiguous
                    if full.lower().endswith(".tar") and not archives[s].lower().endswith(".tar"):
                        archives[s] = full
                    continue
                archives[s] = full
            elif REPORT_RE.match(fn):
                # 往上找「離 parent 最近、名稱含 SlotN」的最上層資料夾當作這個 Slot 的根
                rel = os.path.relpath(root, parent_abs).split(os.sep)
                top = None
                for i, part in enumerate(rel):
                    m2 = SLOT_NAME_RE.search(part)
                    if m2 and int(m2.group(1)) in SLOT_NUMBERS:
                        top = (int(m2.group(1)), os.path.join(parent_abs, *rel[:i + 1]))
                        break
                if top:
                    folders.setdefault(top[0], top[1])

    matched = dict(folders)
    matched.update(archives)  # 壓縮檔優先
    result["matched"] = matched
    result["missing_slots"] = [s for s in SLOT_NUMBERS if s not in matched]
    return result


