def template_layout(ws):
    """回傳 ({slot: Temp欄位col_idx}, {項目列: key})，都是從模板本身讀出來的。"""
    slot_cols = {}
    for c in range(4, ws.max_column + 1):
        m = re.match(r"Slot (\d+)", str(ws.cell(1, c).value or ""))
        if m:
            slot_cols[int(m.group(1))] = c
    if not slot_cols:  # 模板沒有標 Slot 表頭時，退回「Slot8 從 D 欄開始，每個 Slot 2 欄」
        slot_cols = {s: 4 + 2 * i for i, s in enumerate(SLOT_NUMBERS)}
    head = next((r for r in range(1, 15) if ws.cell(r, 2).value == "Item"), 7)
    rows = {r: item_key(ws.cell(r, 2).value)
            for r in range(head + 1, ws.max_row + 1) if ws.cell(r, 2).value}
    return slot_cols, rows, head


def normalize_gpu_rows(ws, rows):
    """
    GPU 相關列依「出現順序」重新命名為 GPU0~GPU3 並加上 PCIe 編號
    (舊模板把瓦數寫成 GPU1~GPU4，這裡一併修正)。
    """
    for pattern, fmt in ((r"GPU\d_AVG_TMP", "GPU{i}_AVG_TMP"), (r"GPU\d_PWR", "GPU{i}_PWR")):
        hit = [r for r, k in rows.items() if re.fullmatch(pattern, k)]
        for i, r in enumerate(hit[:4]):
            rows[r] = fmt.format(i=i)
            ws.cell(r, 2).value = f"{rows[r]} ({GPU_PCIE[i]})"


def value_for(key, sdr_stats, nvq_vals):
    """決定這個項目要填什麼數值；沒有資料回傳 None (留空)。"""
    if key in BLANK_KEYS:
        return None
    if key in NVQUAL_ONLY_KEYS:
        return nvq_vals.get(key)
    name = SDR_ALIAS.get(key, key)
    s = sdr_stats.get(name)
    if not s:
        return None
    return s[0] if is_min_key(name) else s[1]


def process_excel(template_bytes: bytes, slot_sdr: dict, slot_nvq: dict, output_path: str, progress=None):
    """
    slot_sdr / slot_nvq: { slot_number(int): user_input_path(str) }
    回傳: (output_path, status_messages, preview_data)
    preview_data: { sensor_label: { "Slot N": value } }
    """
    say = progress or (lambda m: None)
    wb = openpyxl.load_workbook(io.BytesIO(template_bytes))
    ws = wb.worksheets[0]
    slot_cols, rows, head = template_layout(ws)
    normalize_gpu_rows(ws, rows)
    labels = {r: str(ws.cell(r, 2).value).strip() for r in rows}

    # 先清掉模板裡舊的/示範性質的殘留數值，避免跟新資料混在一起。
    # 注意：openpyxl 的 ws.cell(row, column, value=None) 不會清空儲存格，
    # 必須直接對 cell.value 賦值才能真正清空。
    for slot, col in slot_cols.items():
        ws.cell(row=head, column=col).value = "Temp"
        ws.cell(row=head, column=col + 1).value = "Margin"
        for r in rows:
            ws.cell(row=r, column=col).value = None
            ws.cell(row=r, column=col + 1).value = None

    status_messages = []
    preview_data = {labels[r]: {} for r in rows}
    details = []

    for slot in SLOT_NUMBERS:
        sdr_raw = (slot_sdr.get(slot) or "").strip()
        nvq_raw = (slot_nvq.get(slot) or "").strip()
        if not sdr_raw and not nvq_raw:
            continue  # 使用者沒填這個 slot，跳過
        col = slot_cols.get(slot)
        if col is None:
            status_messages.append(f"Slot {slot}: 模板表頭找不到這個 Slot，已略過")
            continue

        sdr_stats, samples, sdr_files, nvq_vals, runs = {}, 0, [], {}, []

        if sdr_raw:
            say(f"Slot {slot}: 讀取 SDR log...")
            sdr_files, msg = resolve_sdr_files(sdr_raw)
            if msg:
                status_messages.append(f"Slot {slot}: {msg}")
            if sdr_files:
                try:
                    sdr_stats, samples = parse_sdr_files(sdr_files)
                except Exception as e:
                    status_messages.append(f"Slot {slot}: SDR log 讀取失敗 - {e}")
        else:
            status_messages.append(f"Slot {slot}: 沒有填 SDR log，SDR 項目留空")

        if nvq_raw:
            say(f"Slot {slot}: 讀取 NVQual 報表...")
            try:
                reports, msg = resolve_nvqual_reports(nvq_raw, slot)
                if msg:
                    status_messages.append(f"Slot {slot}: {msg}")
                if reports:
                    nvq_vals, notes = collect_nvqual(reports)
                    status_messages += [f"Slot {slot}: {n}" for n in notes]
                    runs = [os.path.basename(r)[len("nvqual_report_"):-len(".xlsx")] for r in reports]
            except Exception as e:
                status_messages.append(f"Slot {slot}: NVQual 讀取失敗 - {e}")
        else:
            status_messages.append(f"Slot {slot}: 沒有填 NVQual，GPU/CPU 項目留空")

        temp_letter = get_column_letter(col)
        blanks = []
        for r, key in rows.items():
            val = value_for(key, sdr_stats, nvq_vals)
            if val is None:
                if key not in BLANK_KEYS:
                    blanks.append(labels[r])
                continue
            val = round(float(val), 2)
            ws.cell(row=r, column=col, value=val)
            preview_data[labels[r]][f"Slot {slot}"] = val

            spec_val = ws.cell(row=r, column=SPEC_COL).value
            if isinstance(spec_val, (int, float)):
                ws.cell(row=r, column=col + 1,
                        value=f"={get_column_letter(SPEC_COL)}{r}-{temp_letter}{r}")
            else:
                ws.cell(row=r, column=col + 1, value="NA")
        if blanks:
            status_messages.append(f"Slot {slot}: 以下項目沒有資料，已留空：{', '.join(blanks)}")
        details.append([slot, "; ".join(sdr_files), samples, ", ".join(runs), ", ".join(blanks)])

    ts = wb.create_sheet("Source details")
    ts.append(["Slot", "SDR file(s)", "SDR samples", "NVQual runs used (max across runs)", "Blank items"])
    for d in details:
        ts.append(d)
    ts.append([])
    ts.append(["SDR 項目 = 整份 log 各感測器各自最大值 (TLIMIT/TMPLIMIT = 最小值)；"
               "GPU/CPU 項目 = 所有 NVQual run 的 Avg 值取最大；Margin = Temp Spec − Temp。"])

    say("儲存 Excel...")
    wb.save(output_path)
    return output_path, status_messages, preview_data


