# 從名稱裡找 "SlotN" (不分大小寫，Slot/slot 中間可以有底線或空白)
# 用 (?<!\d) 和 (?!\d) 確保不會把 Slot1 誤配到 Slot10/Slot11 這種情況
SLOT_NAME_RE = re.compile(r"(?<!\d)slot[\s_-]*?(\d+)(?!\d)", re.IGNORECASE)
REPORT_RE = re.compile(r"^nvqual_report_\d{8}_\d{6}\.xlsx$", re.IGNORECASE)
ARCHIVE_RE = re.compile(r"(?<!\d)slot[\s_-]*?(\d+)(?!\d).*\.(tar|tgz|tar\.gz)$", re.IGNORECASE)
TS_RE = re.compile(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\s*$")

CACHE_ROOT = os.path.join(tempfile.gettempdir(), "sdr_thermal_pwr_cache")


def slot_of(path: str):
    """取路徑中「最後一個」SlotN 的 N；找不到回傳 None。"""
    hits = SLOT_NAME_RE.findall(path)
    return int(hits[-1]) if hits else None


def item_key(label) -> str:
    """'E1S_1_TMP (BayC)' -> 'E1S_1_TMP'；'Lion Chip' -> 'Lion'。"""
    parts = str(label or "").split()
    return parts[0] if parts else ""


def is_min_key(name: str) -> bool:
    return "TLIMIT" in name or "TMPLIMIT" in name


def clean_path(text: str) -> str:
    """接受貼上來的路徑 (含引號、前後空白、file:/// 開頭)。"""
    t = (text or "").strip().strip('"').strip("'").strip()
    return t[8:] if t.lower().startswith("file:///") else t


