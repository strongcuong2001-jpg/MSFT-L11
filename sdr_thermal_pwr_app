    # ------------------------------------------------------------------
    # 事件處理
    # ------------------------------------------------------------------
    def select_template(self):
        path = filedialog.askopenfilename(title="選擇 Excel 模板", filetypes=[("Excel 檔案", "*.xlsx")])
        if path:
            self.template_path_var.set(path)

    def browse_parent(self, var):
        path = filedialog.askdirectory(title="選擇上層資料夾")
        if path:
            var.set(path)

    def browse_folder(self, var, title):
        path = filedialog.askdirectory(title=title)
        if path:
            var.set(path)

    def browse_sdr_file(self, slot):
        path = filedialog.askopenfilename(
            title=f"選擇 Slot {slot} 的 log 檔案",
            filetypes=[("Log / 文字檔", "*.txt *.log"), ("所有檔案", "*.*")],
        )
        if path:
            self.sdr_vars[slot].set(path)

    def browse_nvq_file(self, slot):
        path = filedialog.askopenfilename(
            title=f"選擇 Slot {slot} 的 NVQual 壓縮檔或報表",
            filetypes=[("NVQual 壓縮檔 / 報表", "*.tar *.tgz *.gz *.xlsx"), ("所有檔案", "*.*")],
        )
        if path:
            self.nvq_vars[slot].set(path)

    def match_sdr(self):
        self._apply_match("SDR log", self.sdr_parent_var.get(), auto_match_slot_folders, self.sdr_vars)

    def match_nvqual(self):
        self._apply_match("NVQual", self.nvq_parent_var.get(), auto_match_nvqual, self.nvq_vars)

    def _apply_match(self, what, parent_dir, matcher, target_vars, clear=True):
        parent_dir = clean_path(parent_dir)
        if not parent_dir:
            messagebox.showwarning("提醒", f"請先貼上或選擇 {what} 的上層資料夾")
            return
        result = matcher(parent_dir)
        if result["error"]:
            messagebox.showerror("錯誤", result["error"])
            return

        matched = result["matched"]
        for slot, path in matched.items():
            target_vars[slot].set(path)

        lines = [f"✅ {what} 自動比對成功 {len(matched)} / {len(SLOT_NUMBERS)} 個 Slot："]
        for slot in sorted(matched):
            lines.append(f"   Slot {slot} -> {matched[slot]}")
        if result["missing_slots"]:
            lines += ["", "⚠️ 這些 Slot 沒有找到對應的資料，請手動填寫："
                      + ", ".join(f"Slot {s}" for s in result["missing_slots"])]
        if result["ambiguous"]:
            lines += ["", "⚠️ 以下 Slot 編號同時對應到多個子資料夾，已使用第一個找到的，其餘被忽略："]
            lines += [f"   Slot {s}：{n}" for s, n in result["ambiguous"]]
        if result["unmatched_folders"]:
            lines += ["", "ℹ️ 以下子資料夾名稱看不出 Slot 編號，已略過："]
            lines += [f"   {n}" for n in result["unmatched_folders"]]

        if clear:
            self._clear_log()
        for line in lines:
            self._append_log(line)

    def _auto_fill_from_parents(self):
        """上層資料夾欄位有貼路徑、但對應的 Slot 欄位還是空的，就自動比對一次
        (避免忘記按「自動比對」)。"""
        for name, parent_var, matcher, target in (
            ("SDR log", self.sdr_parent_var, auto_match_slot_folders, self.sdr_vars),
            ("NVQual", self.nvq_parent_var, auto_match_nvqual, self.nvq_vars),
        ):
            if clean_path(parent_var.get()) and not any(v.get().strip() for v in target.values()):
                self._apply_match(name, parent_var.get(), matcher, target, clear=False)

    def clear_slots(self):
        for var in list(self.sdr_vars.values()) + list(self.nvq_vars.values()):
            var.set("")

    def _append_log(self, text):
        self.log_text.configure(state="normal")
        self.log_text.insert("end", text + "\n")
        self.log_text.see("end")
        self.log_text.configure(state="disabled")

    def _clear_log(self):
        self.log_text.configure(state="normal")
        self.log_text.delete("1.0", "end")
        self.log_text.configure(state="disabled")

    def on_run_clicked(self):
        template_path = self.template_path_var.get().strip()
        if not template_path:
            messagebox.showerror("錯誤", "請先選擇 Excel 模板！")
            return
        if not os.path.isfile(template_path):
            messagebox.showerror("錯誤", f"找不到模板檔案：\n{template_path}")
            return

        self._clear_log()
        self._auto_fill_from_parents()
        slot_sdr = {s: v.get() for s, v in self.sdr_vars.items()}
        slot_nvq = {s: v.get() for s, v in self.nvq_vars.items()}
        if not any(p.strip() for p in list(slot_sdr.values()) + list(slot_nvq.values())):
            messagebox.showwarning(
                "提醒", "還沒有任何 Slot 的路徑。\n請在上方貼上 SDR log / NVQual 的上層資料夾路徑 "
                        "(可直接按開始，程式會自動比對)，或針對各 Slot 自行選擇檔案/資料夾。")
            return

        default_name = f"SDR_Thermal_PWR_Margin_Report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
        output_path = filedialog.asksaveasfilename(
            title="選擇輸出 Excel 的儲存位置",
            defaultextension=".xlsx",
            initialfile=default_name,
            filetypes=[("Excel 檔案", "*.xlsx")],
        )
        if not output_path:
            return  # 使用者取消

        self._append_log("\n開始處理，請稍候 (第一次讀 NVQual 壓縮檔需要一點時間)...")
        self.run_button.configure(state="disabled")
        self.status_label.configure(text="處理中...")

        threading.Thread(
            target=self._process_in_background,
            args=(template_path, slot_sdr, slot_nvq, output_path),
            daemon=True,
        ).start()
        self._poll_queue()

    def _process_in_background(self, template_path, slot_sdr, slot_nvq, output_path):
        q = self._queue
        try:
            with open(template_path, "rb") as f:
                template_bytes = f.read()
            result = process_excel(
                template_bytes, slot_sdr, slot_nvq, output_path,
                progress=lambda msg: q.put(("progress", msg)),
            )
            q.put(("done", result + (None,)))
        except Exception as e:
            q.put(("done", (None, [], {}, (e, traceback.format_exc()))))

    def _poll_queue(self):
        """主執行緒定時取出背景執行緒的訊息：更新進度，或在完成時顯示結果。"""
        try:
            while True:
                kind, payload = self._queue.get_nowait()
                if kind == "progress":
                    self.status_label.configure(text=payload)
                else:
                    self._on_process_done(*payload)
                    return
        except queue.Empty:
            pass
        self.after(100, self._poll_queue)

    def _on_process_done(self, result_path, status_messages, preview_data, error):
        self.run_button.configure(state="normal")
        self.status_label.configure(text="")

        if error is not None:
            e, err_text = error
            self._append_log(f"❌ 處理失敗：{e}")
            self._append_log(err_text)
            messagebox.showerror("處理失敗", f"發生錯誤：\n{e}")
            return

        if status_messages:
            self._append_log(f"⚠️ 共 {len(status_messages)} 則提醒：")
            for msg in status_messages:
                self._append_log(" - " + msg)
        elif preview_data and any(preview_data.values()):
            self._append_log("✅ 全部項目都有讀到數值，沒有異常訊息。")

        filled_slots = sorted({sl for d in preview_data.values() for sl in d},
                              key=lambda s: int(s.split()[1]))
        self._append_log(f"\n已填寫資料的 Slot：{', '.join(filled_slots) if filled_slots else '（無）'}")
        self._append_log(f"\n✅ 完成！已儲存至：\n{result_path}")

        if messagebox.askyesno("完成", f"Excel 已產生完成：\n{result_path}\n\n要開啟所在資料夾嗎？"):
            self._open_containing_folder(result_path)

    def _open_containing_folder(self, path):
        folder = os.path.dirname(os.path.abspath(path))
        try:
            if sys.platform.startswith("win"):
                os.startfile(folder)
            elif sys.platform == "darwin":
                os.system(f'open "{folder}"')
            else:
                os.system(f'xdg-open "{folder}"')
        except Exception as e:
            messagebox.showwarning("提醒", f"無法自動開啟資料夾，請手動前往：\n{folder}\n\n({e})")


if __name__ == "__main__":
    app = SdrApp()
    app.mainloop()
