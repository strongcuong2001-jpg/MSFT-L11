def resolve_sdr_files(user_path: str):
    """
    使用者輸入可能是：
      - 直接的 log 檔案路徑 (.txt/.log)
      - 資料夾路徑 (裡面放 log 檔，可能還包了一層同名子資料夾)
    回傳 ([檔案路徑...], 附帶訊息 或 None)
    """
    user_path = clean_path(user_path)
    if not user_path:
        return [], "路徑空白"

    if os.path.isfile(user_path):
        return [user_path], None

    if not os.path.isdir(user_path):
        return [], f"找不到這個路徑：{user_path}"

    txts = []
    for root, _dirs, files in os.walk(user_path):
        for fn in files:
            if fn.lower().endswith((".txt", ".log")):
                full = os.path.join(root, fn)
                txts.append((os.path.getsize(full), full))
    if not txts:
        return [], f"資料夾(含子資料夾)內找不到 .txt/.log 檔案：{user_path}"

    sdr = [f for _, f in txts if os.path.basename(f).lower().startswith("sdr_test_")]
    if sdr:
        return sorted(sdr), None
    best = max(txts)[1]
    return [best], f"找不到 sdr_test_*.txt，已自動選用檔案最大的：{os.path.basename(best)}"


def parse_sdr_files(files):
    """
    掃描整份 log，每個 sensor 各自記錄「整段測試期間」的 [最小值, 最大值]。
    log 每行格式類似：
        SENSOR_NAME      | 48 degrees C      | ok
        HSC0_INPUT_PWR   | 15 Watts          | ok
    回傳 (stats, samples)：stats = { sensor: [min, max] }，samples = 取樣時間點數量
    """
    stats = {}
    samples = 0
    for path in files:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if TS_RE.match(line):
                    samples += 1
                    continue
                parts = line.split("|")
                if len(parts) < 3:
                    continue
                tok = parts[1].split()
                if not tok or tok[0].lower().startswith("0x"):
                    continue  # 略過 0x01 這種狀態值
                try:
                    val = float(tok[0])
                except ValueError:
                    continue
                key = parts[0].strip()
                s = stats.get(key)
                if s is None:
                    stats[key] = [val, val]
                else:
                    if val < s[0]:
                        s[0] = val
                    if val > s[1]:
                        s[1] = val
    return stats, samples


