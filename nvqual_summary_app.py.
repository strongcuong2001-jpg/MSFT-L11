def clean_stem(filename):
    """取得標準檔名主體，消除字尾與副檔名差異"""
    name = os.path.splitext(filename)[0]
    name = re.sub(r"^nvqual_(report_)?", "", name, flags=re.IGNORECASE)
    return name.strip()


def extract_date_from_filename(filename):
    """從檔名擷取 YYYY/MM/DD 日期格式"""
    match = re.search(r"(\d{4})(\d{2})(\d{2})", filename)
    if match:
        return f"{match.group(1)}/{match.group(2)}/{match.group(3)}"
    return "Unknown Date"


def parse_excel_fast(file_input):
    """高效讀取 Excel I15 儲存格"""
    wb = None
    try:
        wb = openpyxl.load_workbook(file_input, data_only=True, read_only=True)
        sheet_names = wb.sheetnames
        sheet = wb[sheet_names[0]]

        d15_val = str(sheet.cell(row=15, column=4).value or "").strip()
        i15_val = str(sheet.cell(row=15, column=9).value or "").strip()

        excel_status = "FAIL" if "FAIL" in d15_val.upper() else "PASS"
        fname = getattr(file_input, "name", os.path.basename(str(file_input)))

        final_reason = "N/A"
        if excel_status == "FAIL" and i15_val and i15_val.upper() not in ["NONE", "N/A"]:
            final_reason = i15_val

        return {
            "Status": excel_status,
            "Fail Reason": final_reason,
            "Excel_Filename": fname,
        }
    except Exception as e:
        fname = getattr(file_input, "name", os.path.basename(str(file_input)))
        return {
            "Status": "ERROR",
            "Fail Reason": f"Excel 解析失敗: {str(e)}",
            "Excel_Filename": fname,
        }
    finally:
        if wb:
            wb.close()
        gc.collect()


def parse_large_log_stream(file_input):
    """解析 Log 檔，精準擷取 Fail 訊息"""
    serial_number = "Unknown"
    version = "v1.8"
    status = "PASS"
    fail_notes = []
    has_fail = False

    is_uploaded = hasattr(file_input, "read")
    fname = file_input.name if is_uploaded else os.path.basename(file_input)

    try:
        if is_uploaded:
            content_bytes = file_input.read()
            lines = content_bytes.decode("utf-8", errors="ignore").splitlines()
        else:
            with open(file_input, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()

        head_text = "\n".join(lines[:200])

        sn_direct_match = re.search(r"\b(P[0-9A-Z]{15})\b", head_text)
        if sn_direct_match:
            serial_number = sn_direct_match.group(1)
        else:
            sn_match = re.search(r"Serial\s*Number\s*[:=]?\s*([A-Za-z0-9_-]+)", head_text, re.IGNORECASE)
            if sn_match:
                serial_number = sn_match.group(1)

        full_text = "\n".join(lines)

        if "FAIL" in head_text.upper() or "did not complete" in full_text or "An Exception occurred" in full_text:
            has_fail = True

            timeout_match = re.search(r"(SSD subtest did not complete within \d+ sec timeout)", full_text)
            if timeout_match:
                fail_notes.append(timeout_match.group(1).strip())

            thermal_match = re.search(r"(An Exception occurred in thermal ssd test[^\n]*)", full_text)
            if thermal_match:
                fail_notes.append(thermal_match.group(1).strip())

            io_error_match = re.search(r"(IO Errors found during SSD test on device[^\n]*)", full_text)
            if io_error_match:
                fail_notes.append(io_error_match.group(1).strip())
            else:
                general_exc_match = re.search(r"(An Exception occurred\.\s*See Exception\.log[^\n]*)", full_text, re.IGNORECASE)
                if general_exc_match:
                    fail_notes.append(general_exc_match.group(1).strip())

            if not fail_notes:
                for line in lines:
                    line_clean = line.strip()
                    if "An Exception occurred" in line_clean or "SSD subtest did not complete" in line_clean:
                        fail_notes.append(line_clean)

    except Exception as e:
        has_fail = True
        fail_notes.append(f"Log 讀取例外: {str(e)}")

    sn_info = SN_MAPPING.get(serial_number, {"Source": "Unknown", "Slot": 999})

    if has_fail:
        status = "FAIL"
        unique_notes = list(dict.fromkeys(fail_notes))
        fail_reason_str = "\n".join(unique_notes) if unique_notes else "Unspecified FAIL"
    else:
        status = "PASS"
        fail_reason_str = "N/A"

    return {
        "NVQUAL Version": version,
        "Source": sn_info["Source"],
        "Slot": sn_info["Slot"],
        "Serial Number": serial_number,
        "Log_Status": status,
        "Log_Fail_Reason": fail_reason_str,
        "Log_Filename": fname,
    }


def generate_multi_loop_excel(df_matrix):
    """產出每一圈結果獨立分成不同欄/列的 Excel 報表"""
    output = io.BytesIO()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Multi-Loop Matrix"

    thin_border = Border(
        left=Side(style='thin', color='D3D3D3'),
        right=Side(style='thin', color='D3D3D3'),
        top=Side(style='thin', color='D3D3D3'),
        bottom=Side(style='thin', color='D3D3D3')
    )

    header_fill = PatternFill(start_color="FFF2CC", end_color="FFF2CC", fill_type="solid")
    pass_fill = PatternFill(start_color="E2EFDA", end_color="E2EFDA", fill_type="solid")
    fail_fill = PatternFill(start_color="FCE4D6", end_color="FCE4D6", fill_type="solid")

    font_bold = Font(name="Calibri", size=11, bold=True)
    font_regular = Font(name="Calibri", size=10)

    ws.append([str(c[0]) for c in df_matrix.columns])
    ws.append([str(c[1]) for c in df_matrix.columns])
    ws.append([str(c[2]) for c in df_matrix.columns])

    for row in df_matrix.itertuples(index=False):
        ws.append(list(row))

    for r_idx, row in enumerate(ws.iter_rows(min_row=1, max_row=ws.max_row, min_col=1, max_col=ws.max_column), start=1):
        for c_idx, cell in enumerate(row, start=1):
            cell.border = thin_border
            cell.alignment = Alignment(vertical="center", wrap_text=True)

            if r_idx <= 3:
                cell.fill = header_fill
                cell.font = font_bold
                cell.alignment = Alignment(horizontal="center", vertical="center")
            elif c_idx in [1, 2]:
                cell.font = font_bold
                cell.alignment = Alignment(horizontal="center", vertical="center")
            else:
                cell.font = font_regular
                val = str(cell.value or "")
                if val == "PASS":
                    cell.fill = pass_fill
                    cell.alignment = Alignment(horizontal="center", vertical="center")
                elif val != "" and val != "N/A":
                    cell.fill = fail_fill

    for col in ws.columns:
        max_len = max(len(str(cell.value or '')) for cell in col)
        col_letter = get_column_letter(col[0].column)
        ws.column_dimensions[col_letter].width = min(max(max_len + 3, 14), 45)

    wb.save(output)
    return output.getvalue()


