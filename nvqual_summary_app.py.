            "方法二：手動選擇/補上傳單獨檔案 (.log, .xlsx)",
            type=["log", "txt", "xlsx"],
            accept_multiple_files=True,
        )

    excel_map = {}
    log_files = []

    if folder_path:
        if os.path.exists(folder_path):
            with st.spinner("⏳ 正在分析資料夾中的檔案，請稍候..."):
                for root, _, files in os.walk(folder_path):
                    for f in files:
                        file_path = os.path.join(root, f)
                        fname = os.path.basename(file_path)

                        if fname.lower().endswith(".xlsx") and not fname.startswith("~$"):
                            stem_key = clean_stem(fname)
                            excel_map[stem_key] = parse_excel_fast(file_path)
                        elif fname.lower().endswith((".log", ".txt")):
                            log_files.append(parse_large_log_stream(file_path))
        else:
            st.error(f"❌ 找不到該資料夾路徑，請確認路徑是否正確：`{folder_path}`")

    if uploaded_files:
        with st.spinner("⏳ 正在處理上傳的檔案..."):
            for file_obj in uploaded_files:
                fname = file_obj.name
                if fname.lower().endswith(".xlsx") and not fname.startswith("~$"):
                    stem_key = clean_stem(fname)
                    excel_map[stem_key] = parse_excel_fast(file_obj)
                elif fname.lower().endswith((".log", ".txt")):
                    log_files.append(parse_large_log_stream(file_obj))

    if log_files:
        data_list = []
        for log in log_files:
            log_fname = log["Log_Filename"]
            log_stem = clean_stem(log_fname)
            test_date = extract_date_from_filename(log_fname)

            excel_data = excel_map.get(log_stem, None)

            if (excel_data and excel_data["Status"] == "FAIL") or log["Log_Status"] == "FAIL":
                status = "FAIL"
                if excel_data and excel_data["Fail Reason"] != "N/A":
                    fail_reason = excel_data["Fail Reason"]
                else:
                    fail_reason = log["Log_Fail_Reason"]
            else:
                status = "PASS"
                fail_reason = "PASS"

            data_list.append(
                {
                    "Date": test_date,
                    "Filename": log["Log_Filename"],
                    "NVQUAL Version": log["NVQUAL Version"],
                    "Source": log["Source"],
                    "Slot": int(log["Slot"]) if str(log["Slot"]).isdigit() else 999,
                    "Serial Number": log["Serial Number"],
                    "Status": status,
                    "Fail Reason": fail_reason,
                }
            )

        df = pd.DataFrame(data_list)
        df = df.sort_values(by=["Slot", "Filename"], ascending=[True, True]).reset_index(drop=True)

        st.sidebar.markdown("### 🔍 條件篩選面板 / Filter Panel", unsafe_allow_html=True)

        status_options = ["All"] + list(df["Status"].unique())
        selected_status = st.sidebar.selectbox("篩選 Status / Filter Status", status_options)

        source_options = ["All"] + list(df["Source"].unique())
        selected_source = st.sidebar.selectbox("篩選 Source / Filter Source", source_options)

        slot_options = sorted([s for s in df["Slot"].unique() if s != 999])
        selected_slots = st.sidebar.multiselect(
            "篩選 Slot / Filter Slot (可多選)",
            options=slot_options,
            placeholder="選擇一或多個 Slot...",
        )

        sn_options = ["All"] + sorted([sn for sn in df["Serial Number"].unique() if sn != "Unknown"])
        selected_sn = st.sidebar.selectbox("篩選 Serial Number / Filter SN", sn_options)

        version_options = ["All"] + list(df["NVQUAL Version"].unique())
        selected_version = st.sidebar.selectbox("篩選 NVQUAL Version / Filter Version", version_options)

        fail_combinations = df[df["Status"] == "FAIL"]["Fail Reason"].unique().tolist()
        fail_combo_options = ["All Fail Combinations"] + fail_combinations
        selected_combo = st.sidebar.selectbox("篩選 Fail 原因組合 / Filter Fail Pattern", fail_combo_options)

        search_keyword = st.sidebar.text_input("關鍵字搜尋 / Keyword Search", "")

        filtered_df = df.copy()

        if selected_status != "All":
            filtered_df = filtered_df[filtered_df["Status"] == selected_status]

        if selected_source != "All":
            filtered_df = filtered_df[filtered_df["Source"] == selected_source]

        if selected_slots:
            filtered_df = filtered_df[filtered_df["Slot"].isin(selected_slots)]

        if selected_sn != "All":
            filtered_df = filtered_df[filtered_df["Serial Number"] == selected_sn]

        if selected_version != "All":
            filtered_df = filtered_df[filtered_df["NVQUAL Version"] == selected_version]

        if selected_combo != "All Fail Combinations":
            filtered_df = filtered_df[filtered_df["Fail Reason"] == selected_combo]

        if search_keyword:
            filtered_df = filtered_df[
                filtered_df["Serial Number"].str.contains(search_keyword, case=False, na=False)
                | filtered_df["Slot"].astype(str).str.contains(search_keyword, case=False, na=False)
                | filtered_df["Fail Reason"].str.contains(search_keyword, case=False, na=False)
                | filtered_df["Filename"].str.contains(search_keyword, case=False, na=False)
            ]

        st.markdown("---")
        col1, col2, col3, col4 = st.columns(4)

        total_count = len(df)
        pass_df = df[df["Status"] == "PASS"]
        fail_df = df[df["Status"] == "FAIL"]
        versions = df["NVQUAL Version"].unique()

        col1.metric("總讀取數 / Total", total_count)
        col2.metric("PASS 筆數 / Pass", len(pass_df))
        col3.metric("FAIL 筆數 / Fail", len(fail_df))
        col4.metric("NVQUAL 版本 / Version", ", ".join(versions))

        # --- 1. 直式明細列表 ---
        st.markdown(
            f"### 📋 分析明細列表 (直式) / Detail List (共 {len(filtered_df)} 筆符合)",
            unsafe_allow_html=True,
        )

        st.dataframe(
            filtered_df.drop(columns=["Date"]),
            column_config={
                "Filename": st.column_config.TextColumn("Filename / 檔名", width="medium"),
                "NVQUAL Version": st.column_config.TextColumn("Version / 版本", width="small"),
                "Source": st.column_config.TextColumn("Source / 來源", width="small"),
                "Slot": st.column_config.NumberColumn("Slot / 插槽", format="%d", width="small"),
                "Serial Number": st.column_config.TextColumn("Serial Number / 序號", width="medium"),
                "Status": st.column_config.TextColumn("Status / 狀態", width="small"),
                "Fail Reason": st.column_config.TextColumn("Fail Reason / 失敗原因組合", width="large"),
            },
            width="stretch",
            hide_index=True,
        )

        # --- 2. 橫向矩陣視圖 (Slot 依數值從小到大排序) ---
        st.markdown("---")
        st.markdown("### ↔️ 每圈獨立列 + 4 欄獨立標頭 Slot 橫向矩陣")
        st.caption("💡 Slot 依數值小到大排列（Slot 8 ➜ Slot 9 ➜ Slot 10...）；每一圈（Pass/Loop）各自佔據獨立一列。")

        filtered_df_sorted = filtered_df.sort_values(by=["Date", "Slot", "Filename"]).copy()
        filtered_df_sorted["Loop"] = filtered_df_sorted.groupby(["Date", "Slot"]).cumcount() + 1
        filtered_df_sorted["Loop_Label"] = filtered_df_sorted["Loop"].apply(lambda x: f"Pass {x}")

        matrix_rows = []
        for _, row in filtered_df_sorted.iterrows():
            content = "PASS" if row["Status"] == "PASS" else row["Fail Reason"]
            matrix_rows.append({
                "Date": row["Date"],
                "Loop": row["Loop_Label"],
                "Source": row["Source"],
                "Slot_Num": int(row["Slot"]),
                "Slot_Label": f"Slot {row['Slot']}",
                "Serial Number": row["Serial Number"],
                "Content": content
            })

        if matrix_rows:
            m_df = pd.DataFrame(matrix_rows)

            pivot_df = m_df.pivot_table(
                index=["Date", "Loop"],
                columns=["Source", "Slot_Num", "Slot_Label", "Serial Number"],
                values="Content",
                aggfunc="first"
            ).fillna("")

            # 依 Slot 數值嚴格排序 (8 -> 9 -> 10...)
            sorted_cols = sorted(pivot_df.columns, key=lambda x: (x[0], x[1], x[2], x[3]))
            pivot_df = pivot_df[sorted_cols]

            # 產生 Excel 匯出用 DataFrame (移除排序用中間欄位 Slot_Num)
            excel_cols = [(col[0], col[2], col[3]) for col in pivot_df.columns]
            export_df = pivot_df.copy()
            export_df.columns = pd.MultiIndex.fromTuples(excel_cols) if hasattr(pd.MultiIndex, 'fromTuples') else pd.MultiIndex.from_tuples(excel_cols)
            export_df = export_df.reset_index()

            # 前端展視呈現用 DataFrame
            st.dataframe(export_df, width="stretch")

            # 下載 Excel
            excel_bytes = generate_multi_loop_excel(export_df)
            st.download_button(
                label="📥 下載多圈獨立橫向矩陣 Excel 報表 (.xlsx)",
                data=excel_bytes,
                file_name="nvqual_multi_loop_matrix.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )

        # --- 3. Fail 原因統計與專屬 CSV 下載 ---
        st.markdown("---")
        st.markdown("### ⚠️ Fail 原因組合統計 / Fail Patterns Summary")

        fail_summary_df = filtered_df[filtered_df["Status"] == "FAIL"]

        if not fail_summary_df.empty:
            summary = fail_summary_df["Fail Reason"].value_counts().reset_index()
            summary.columns = ["Fail Reason / 失敗原因組合", "數量 / Count"]

            total_fails = len(fail_summary_df)
            summary["佔總 Fail 比例 / Percentage"] = summary["數量 / Count"].apply(
                lambda x: f"{(x / total_fails) * 100:.1f}%"
            )

            st.dataframe(
                summary,
                column_config={
                    "Fail Reason / 失敗原因組合": st.column_config.TextColumn("Fail Reason / 失敗原因組合", width="large"),
                    "數量 / Count": st.column_config.NumberColumn("數量 / Count", format="%d", width="small"),
                    "佔總 Fail 比例 / Percentage": st.column_config.TextColumn("佔總 Fail 比例 / Percentage", width="small"),
                },
                width="stretch",
                hide_index=True,
            )

            st.markdown("---")
            fail_summary_csv = summary.to_csv(index=False).encode("utf-8-sig")
            st.download_button(
                label="📥 下載 Fail 原因組合統計 CSV / Download Fail Patterns CSV",
                data=fail_summary_csv,
                file_name="fail_patterns_summary.csv",
                mime="text/csv",
            )
        else:
            st.success("🎉 目前篩選條件下沒有任何 FAIL 紀錄！ / No FAIL records found under current filters.")

    elif folder_path and os.path.exists(folder_path):
        st.warning("⚠️ 該資料夾中沒有找到任何 `.log`, `.txt` 或 `.xlsx` 檔案，請檢查資料夾內容！")
    else:
        st.info("請輸入資料夾路徑或拖曳/點擊選擇單獨檔案進行解析。")


